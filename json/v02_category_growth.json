{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart showing the number of AFL Footy Stars card categories in 2020, 2022, 2024 and 2026.",
  "width": "container",
  "height": 360,
  "background": null,
  "data": {
    "url": "data/v02_category_growth.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 90
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Release Year",
          "sort": [
            "2020",
            "2022",
            "2024",
            "2026"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "grid": false
          }
        },
        "y": {
          "field": "category_count",
          "type": "quantitative",
          "title": "Number of Card Categories",
          "scale": {
            "zero": true,
            "domain": [
              0,
              30
            ]
          },
          "axis": {
            "tickMinStep": 5,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "gridColor": "#E3E0D8",
            "gridOpacity": 0.8
          }
        },
        "color": {
          "value": "#174A7E"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "category_count",
            "type": "quantitative",
            "title": "Card Categories"
          },
          {
            "field": "change_from_previous",
            "type": "nominal",
            "title": "Change from Previous Release"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#17212B"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2020",
            "2022",
            "2024",
            "2026"
          ]
        },
        "y": {
          "field": "category_count",
          "type": "quantitative"
        },
        "text": {
          "field": "category_count",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}