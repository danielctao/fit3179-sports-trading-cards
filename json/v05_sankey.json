{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Sankey-style alluvial diagram showing AFL Footy Stars checklist categories flowing from release year to analytical category family to scarcity signal.",
  "width": 950,
  "height": 550,
  "padding": 10,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": [
    {
      "name": "links",
      "url": "data/v05_sankey_links.csv",
      "format": {
        "type": "csv",
        "parse": {
          "count": "number"
        }
      }
    },
    {
      "name": "nodes",
      "url": "data/v05_sankey_nodes.csv",
      "format": {
        "type": "csv",
        "parse": {
          "count": "number",
          "x0": "number",
          "x1": "number",
          "y0": "number",
          "y1": "number"
        }
      }
    }
  ],
  "scales": [
  {
    "name": "familyColor",
    "type": "ordinal",

    "domain": [
      "Base",
      "Character / Illustrated",
      "Player Feature / Performance",
      "Parallel / Variant",
      "Predictor / Redemption",
      "Premium / Limited",
      "Signature / Patch",
      "Prize / Promotion"
    ],

    "range": [
      "#2F80ED",
      "#00B8D9",
      "#5E60CE",
      "#8A4FFF",
      "#B44CFF",
      "#D84FD3",
      "#FF5CA8",
      "#B9C8D9"
    ]
  },

  {
    "name": "statusColor",
    "type": "ordinal",

    "domain": [
      "Serial-numbered",
      "Pack odds only",
      "Neither stated"
    ],

    "range": [
      "#758A98",
      "#5D7280",
      "#465A68"
    ]
  }
],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 80
          },
          "y": {
            "value": 24
          },
          "text": {
            "value": "RELEASE YEAR"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#C3CDD3"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 425
          },
          "y": {
            "value": 24
          },
          "text": {
            "value": "CATEGORY FAMILY"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#C3CDD3"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 790
          },
          "y": {
            "value": 24
          },
          "text": {
            "value": "SCARCITY SIGNAL"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#C3CDD3"
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "links"
      },

      "encode": {
        "enter": {
          "path": {
            "field": "path"
          },

          "fill": {
            "scale": "familyColor",
            "field": "family"
          },

          "fillOpacity": {
            "value": 0.65
          },

          "stroke": {
            "value": "#F5F7F8"
          },

          "strokeOpacity": {
            "value": 0.12
          },

          "tooltip": {
            "signal": "{'Flow': datum.stage, 'From': datum.source, 'To': datum.target, 'Distinct Categories': datum.count}"
          }
        },

        "update": {
          "fillOpacity": {
            "value": 0.65
          }
        },

        "hover": {
          "fillOpacity": {
            "value": 0.82
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.stage === 'Family' ? scale('familyColor', datum.key) : datum.stage === 'Status' ? scale('statusColor', datum.key) : '#394D5A'"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 0.65
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'Stage': datum.stage, 'Label': datum.label, 'Distinct Categories': datum.count}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.stage === 'Year' ? datum.x0 - 8 : datum.stage === 'Status' ? datum.x1 + 8 : datum.x1 + 8"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "align": {
            "signal": "datum.stage === 'Year' ? 'right' : 'left'"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "datum.label"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "signal": "datum.stage === 'Family' ? 'normal' : 'bold'"
          },
          "fill": {
            "value": "#F5F7F8"
          }
        }
      }
    }
  ]
}