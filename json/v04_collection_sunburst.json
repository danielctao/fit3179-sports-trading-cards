{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Two-ring sunburst showing the composition of the 2026 AFL Footy Stars collection by analytical category family and individual checklist category.",
  "width": 860,
  "height": 520,
  "padding": 10,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "cx",
      "update": "width * 0.38"
    },
    {
      "name": "cy",
      "update": "height * 0.55"
    }
  ],
  "data": [
    {
      "name": "source",
      "url": "data/v04_collection_sunburst.csv",
      "format": {
        "type": "csv",
        "parse": {
          "start_angle": "number",
          "end_angle": "number",
          "inner_radius": "number",
          "outer_radius": "number",
          "design_count": "number",
          "family_category_count": "number"
        }
      }
    },
    {
      "name": "families",
      "source": "source",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.level === 'Family'"
        }
      ]
    },
    {
      "name": "categories",
      "source": "source",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.level === 'Category'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "familyColor",
      "type": "ordinal",
      "domain": [
        "Base",
        "Character / Illustrated",
        "Player Feature / Performance",
        "Parallel / Variant",
        "Premium / Limited",
        "Signature / Patch",
        "Prize / Promotion"
      ],
      "range": [
        "#2F80ED",
        "#00B8D9",
        "#5E60CE",
        "#8A4FFF",
        "#D84FD3",
        "#FF5CA8",
        "#B9C8D9"
      ]
    }
  ],
  "legends": [
  {
    "fill": "familyColor",
    "title": "Category Family",

    "orient": "none",
    "legendX": 640,
    "legendY": 60,

    "labelFont": "DM Sans",
    "labelFontSize": 12,
    "labelColor": "#F5F7F8",
    "labelLimit": 280,

    "titleFont": "DM Sans",
    "titleFontSize": 13,
    "titleFontWeight": "bold",
    "titleColor": "#F5F7F8",

    "symbolType": "square",
    "symbolSize": 100,

    "rowPadding": 5
  }
],
  "marks": [
    {
      "type": "arc",
      "from": {
        "data": "families"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "field": "start_angle"
          },
          "endAngle": {
            "field": "end_angle"
          },
          "innerRadius": {
            "field": "inner_radius"
          },
          "outerRadius": {
            "field": "outer_radius"
          },
          "fill": {
            "scale": "familyColor",
            "field": "family"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'Category Family': datum.family, 'Distinct Categories': datum.family_category_count, 'Reported Card Designs': format(datum.design_count, ',d')}"
          }
        },
        "update": {
          "opacity": {
            "value": 1
          }
        },
        "hover": {
          "opacity": {
            "value": 0.82
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "categories"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "field": "start_angle"
          },
          "endAngle": {
            "field": "end_angle"
          },
          "innerRadius": {
            "field": "inner_radius"
          },
          "outerRadius": {
            "field": "outer_radius"
          },
          "fill": {
            "scale": "familyColor",
            "field": "family"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 1.3
          },
          "tooltip": {
            "signal": "{'Checklist Category': datum.category, 'Category Family': datum.family, 'Reported Card Designs': format(datum.design_count, ',d'), 'Pack Odds': datum.pack_odds, 'Serial Numbered To': datum.serial_numbered_to, 'Distribution': datum.distribution_variant}"
          }
        },
        "update": {
          "opacity": {
            "value": 0.55
          }
        },
        "hover": {
          "opacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy - 8"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "value": "2026"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 28
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#F5F7F8"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy + 22"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "value": "2,284 designs"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#C3CDD3"
          }
        }
      }
    }
  ]
}