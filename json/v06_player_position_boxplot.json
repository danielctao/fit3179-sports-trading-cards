{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Interval plot comparing player representation across AFL positions by release year.",

  "width": "container",
  "height": 330,
  "background": null,

  "data": {
    "url": "data/v06_player_representation.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "string",
        "position_sort": "number",
        "card_design_count": "number",
        "category_count": "number",
        "jitter_bucket": "number"
      }
    }
  },

  "params": [
    {
      "name": "releaseYear",
      "value": "2026",

      "bind": {
        "input": "select",
        "options": [
          "2020",
          "2022",
          "2024",
          "2026"
        ],
        "name": "Release year: "
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.year == releaseYear"
    },
    {
      "aggregate": [
        {
          "op": "min",
          "field": "card_design_count",
          "as": "min_value"
        },
        {
          "op": "q1",
          "field": "card_design_count",
          "as": "q1_value"
        },
        {
          "op": "median",
          "field": "card_design_count",
          "as": "median_value"
        },
        {
          "op": "q3",
          "field": "card_design_count",
          "as": "q3_value"
        },
        {
          "op": "max",
          "field": "card_design_count",
          "as": "max_value"
        },
        {
          "op": "count",
          "as": "player_count"
        }
      ],

      "groupby": [
        "position_group",
        "position_sort"
      ]
    }
  ],

  "encoding": {
    "y": {
      "field": "position_group",
      "type": "nominal",
      "title": null,

      "sort": [
        "Defender",
        "Midfielder",
        "Midfielder / Forward",
        "Forward",
        "Ruck"
      ],

      "axis": {
        "labelFont": "DM Sans",
        "labelFontSize": 12,
        "labelColor": "#F5F7F8",
        "labelLimit": 180,

        "ticks": false,
        "domain": false
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "stroke": "#9AA3AA",
        "opacity": 0.65
      },

      "encoding": {
        "x": {
          "field": "min_value",
          "type": "quantitative",
          "title": "Card Designs per Player",

          "scale": {
            "domain": [
              0,
              18
            ]
          },

          "axis": {
            "tickMinStep": 1,

            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "labelColor": "#C3CDD3",

            "titleFont": "DM Sans",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#F5F7F8",

            "domainColor": "#73818A",
            "tickColor": "#73818A",

            "gridColor": "#AAB5BC",
            "gridOpacity": 0.15
          }
        },

        "x2": {
          "field": "max_value"
        }
      }
    },

    {
      "mark": {
        "type": "rule",
        "strokeWidth": 12,
        "stroke": "#C7D2DA",
        "strokeCap": "round"
      },

      "encoding": {
        "x": {
          "field": "q1_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              18
            ]
          }
        },

        "x2": {
          "field": "q3_value"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,

        "color": "#FAF9F3",
        "stroke": "#2E2E2E",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "median_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              18
            ]
          }
        },

        "tooltip": [
          {
            "field": "position_group",
            "type": "nominal",
            "title": "Player Position"
          },
          {
            "field": "player_count",
            "type": "quantitative",
            "title": "Players"
          },
          {
            "field": "min_value",
            "type": "quantitative",
            "title": "Minimum",
            "format": ".2~f"
          },
          {
            "field": "q1_value",
            "type": "quantitative",
            "title": "Q1",
            "format": ".2~f"
          },
          {
            "field": "median_value",
            "type": "quantitative",
            "title": "Median",
            "format": ".2~f"
          },
          {
            "field": "q3_value",
            "type": "quantitative",
            "title": "Q3",
            "format": ".2~f"
          },
          {
            "field": "max_value",
            "type": "quantitative",
            "title": "Maximum",
            "format": ".2~f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "DM Sans"
  }
}