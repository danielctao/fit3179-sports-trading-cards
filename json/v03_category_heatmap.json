{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap showing AFL Footy Stars category-family changes across 2020, 2022, 2024 and 2026.",
  "width": "container",
  "height": 390,
  "background": null,
  "data": {
    "url": "data/v03_category_heatmap.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": ["2020", "2022", "2024", "2026"],
          "axis": {
            "orient": "top",
            "title": null,
            "labelAngle": 0,
            "labelFont": "DM Sans",
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelColor": "#F5F7F8",
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": [
            "Base",
            "Character / Illustrated",
            "Player Feature / Performance",
            "Parallel / Variant",
            "Predictor / Redemption",
            "Premium / Limited",
            "Signature / Patch",
            "Prize / Promotion"
          ],
          "axis": {
            "title": null,
            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "labelColor": "#F5F7F8",
            "labelLimit": 240,
            "labelPadding": 18,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "category_count",
          "type": "quantitative",
          "title": "Number of Categories",
          "scale": {
            "domain": [0, 9],
            "range": [
              "#F2D66B",
              "#EFA94A",
              "#EB7A28",
              "#DE5B1F",
              "#C9451E",
              "#9E331C"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 14,
            "titleFont": "DM Sans",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titleColor": "#F5F7F8",
            "labelFont": "DM Sans",
            "labelFontSize": 11,
            "labelColor": "#D9D9D9"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "family",
            "type": "nominal",
            "title": "Category Family"
          },
          {
            "field": "category_count",
            "type": "quantitative",
            "title": "Distinct Categories"
          },
          {
            "field": "reported_designs",
            "type": "quantitative",
            "title": "Reported Card Designs",
            "format": ",d"
          },
          {
            "field": "categories",
            "type": "nominal",
            "title": "Categories"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.category_count == 0 ? '' : datum.category_count",
          "as": "cell_label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": ["2020", "2022", "2024", "2026"]
        },
        "y": {
          "field": "family",
          "type": "nominal",
          "sort": [
            "Base",
            "Character / Illustrated",
            "Player Feature / Performance",
            "Parallel / Variant",
            "Predictor / Redemption",
            "Premium / Limited",
            "Signature / Patch",
            "Prize / Promotion"
          ]
        },
        "text": {
          "field": "cell_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.category_count >= 5",
            "value": "#F5F7F8"
          },
          "value": "#1F4260"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  }
}